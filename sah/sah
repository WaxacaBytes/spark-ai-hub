# tomllib is stdlib only on Python 3.11+. Fall back to the `tomli` backport, or
# to None (validation becomes a no-op) so sah still runs on older Pythons such
# as the one shipped with Synology DSM.
try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover
    try:
        import tomli as tomllib  # type: ignore
    except ModuleNotFoundError:
        tomllib = None  # type: ignore

DEFAULT_HUB = "http://localhost:9000"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "sah"
CONFIG_FILE = CONFIG_DIR / "hub"

# The provider id sah registers inside each client's config. Kept identical
# across clients so a config is recognisable as sah-owned at a glance.
PROVIDER = "sah"
PROVIDER_NAME = "Spark AI Hub"
API_KEY = "sah"

_hub_cache: str | None = None


# ---------------------------------------------------------------- hub discovery


def _hub_candidates() -> list[str]:
    """Ordered Hub URLs to try. $SAH_HUB wins; otherwise every non-empty line of
    the config file (stable name first, IP last — written at install time)."""
    if v := os.environ.get("SAH_HUB"):
        return [v.rstrip("/")]
    if CONFIG_FILE.is_file():
        urls = [ln.strip().rstrip("/") for ln in CONFIG_FILE.read_text().splitlines()]
        if urls := [u for u in urls if u]:
            return urls
    return [DEFAULT_HUB]


def _is_alive(base: str, timeout: float = 1.5) -> bool:
    """Can we open a TCP connection to this Hub's port?

    A TCP connect, not an HTTP request: a live Hub accepts the connection
    instantly even when its app layer is briefly saturated (installs, log
    streaming), whereas a stale address times out. An HTTP probe would give
    false negatives under load and wrongly fall through to a dead address.

    IPv4 is tried first: mDNS names can resolve to a mix of IPv4, IPv6 and
    docker-bridge addresses, and the Hub binds 0.0.0.0, so a stray IPv6 record
    would otherwise eat the whole budget and produce a false "dead" verdict.
    """
    parts = urllib.parse.urlsplit(base)
    host = parts.hostname
    if not host:
        return False
    port = parts.port or (443 if parts.scheme == "https" else 80)
    try:
        infos = socket.getaddrinfo(host, port, proto=socket.IPPROTO_TCP)
    except OSError:
        return False
    infos.sort(key=lambda i: 0 if i[0] == socket.AF_INET else 1)
    for family, socktype, proto, _canon, sockaddr in infos:
        s = socket.socket(family, socktype, proto)
        s.settimeout(timeout)
        try:
            s.connect(sockaddr)
            return True
        except OSError:
            continue
        finally:
            s.close()
    return False


def hub_url() -> str:
    """First reachable Hub address, cached for the life of the process.

    With a single candidate we skip the probe (fast path, matches an explicit
    override). With several — the install-time list — we probe in order and use
    the first that answers, so a changed server IP self-heals via the stable
    mDNS/Tailscale name without the user touching anything."""
    global _hub_cache
    if _hub_cache:
        return _hub_cache
    candidates = _hub_candidates()
    if len(candidates) == 1:
        _hub_cache = candidates[0]
        return _hub_cache
    for base in candidates:
        if _is_alive(base):
            _hub_cache = base
            return base
    _hub_cache = candidates[0]  # nothing answered — most stable candidate
    return _hub_cache


def api_base() -> str:
    return f"{hub_url()}/v1"


def resolved_api_base() -> str:
    """api_base() with an mDNS `.local` hostname replaced by its IPv4 address.

    DIVERGENCE (environment, not preference): Ollama's server is on localhost,
    so it never faces name resolution. sah's Hub is across a LAN and its
    candidate list leads with a stable name. Some clients ship their own
    resolver that does not speak mDNS and simply report the Hub as unreachable.

    Only `.local` is substituted. A Tailscale MagicDNS name, a Cloudflare
    tunnel hostname, a plain DNS name or a literal address is left exactly as
    written: those resolve anywhere, and replacing a tunnel hostname with an
    address would break both TLS SNI and the tunnel's Host-header routing.
    """
    base = api_base()
    parts = urllib.parse.urlsplit(base)
    host = parts.hostname
    if not host or not host.lower().endswith(".local"):
        return base
    try:
        infos = socket.getaddrinfo(host, parts.port, family=socket.AF_INET, proto=socket.IPPROTO_TCP)
    except OSError:
        return base
    if not infos:
        return base
    ip = infos[0][4][0]
    netloc = f"{ip}:{parts.port}" if parts.port else ip
    return urllib.parse.urlunsplit((parts.scheme, netloc, parts.path, parts.query, parts.fragment))


# ------------------------------------------------------------------- the model


class Model:
    """The model the Hub is currently serving — sah's equivalent of Ollama's
    LaunchModel, built from one `/v1/models` entry.

    Capabilities come from the Hub only, as the `capabilities` array the proxy
    attaches to each /v1/models entry from the running recipe's tags. sah used
    to guess vision/video support from the model name with a regex; that guess
    was wrong for every model family released after it was written, so it is
    gone. A Hub that reports nothing leaves every model text-only, which is the
    conservative direction: a client that thinks a model is text-only still
    works, one that wrongly thinks it has vision sends payloads that error.
    """

    def __init__(self, info: dict):
        self.info = info
        self.name: str = info["id"]
        try:
            self.context_length = int(info.get("max_model_len") or 0)
        except (TypeError, ValueError):
            self.context_length = 0
        caps = info.get("capabilities")
        self.capabilities: tuple[str, ...] = tuple(caps) if isinstance(caps, list) else ()

    def has(self, capability: str) -> bool:
        return capability in self.capabilities

    def context(self, default: int = 128000) -> int:
        return self.context_length or default

    def max_output(self, cap: int = 65536) -> int:
        return min(self.context(), cap)

    def input_modalities(self) -> list[str]:
        return ["text", "image"] if self.has("vision") else ["text"]


def current_model_info() -> dict | None:
    try:
        with urllib.request.urlopen(f"{api_base()}/models", timeout=2) as r:
            data = json.loads(r.read())
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        return None
    items = data.get("data") or []
    return items[0] if items else None


def require_model() -> Model:
    info = current_model_info()
    if not info:
        sys.exit(
            f"No model is running on {hub_url()}.\n"
            f"Launch one from the Spark AI Hub web UI first."
        )
    return Model(info)


# --------------------------------------------------------------------- output


_LABEL_W = 19  # one width for every "<label>: <value>" line printed by sah


def kv(label: str, value: str) -> None:
    print(f"{(label + ':').ljust(_LABEL_W)} {value}")


def print_table(rows: list[dict], columns: list[tuple[str, str]]) -> None:
    widths = {}
    for key, title in columns:
        widths[key] = max(len(title), *(len(str(row.get(key, ""))) for row in rows))
    print("  ".join(title.ljust(widths[key]) for key, title in columns))
    print("  ".join("-" * widths[key] for key, _ in columns))
    for row in rows:
        print("  ".join(str(row.get(key, "")).ljust(widths[key]) for key, _ in columns))


# ------------------------------------------------------------- file utilities


def write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    tmp.write_text(text)
    tmp.replace(path)


def write_json(path: Path, data: dict | list) -> None:
    write_text(path, json.dumps(data, indent=2) + "\n")


def read_json(path: Path) -> dict:
    if not path.is_file():
        return {}
    try:
        return json.loads(path.read_text()) or {}
    except json.JSONDecodeError:
        return {}


def rfc3339_now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


# YAML ------------------------------------------------------------------------
#
# sah is stdlib-only (it installs via `curl | sh` onto any laptop), so there is
# no YAML parser available. Files sah generates whole are emitted by _yaml_dump;
# the one file sah has to merge into (Hermes' config.yaml) is edited as text.


def _yaml_scalar(value) -> str:
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    # A JSON string literal is a valid YAML double-quoted scalar, so quoting
    # everything stops a model id like `on` or `1.5` being read back as a bool
    # or a number.
    return json.dumps(str(value))


def yaml_dump(data, indent: int = 0) -> str:
    pad = "  " * indent
    if isinstance(data, dict):
        if not data:
            return f"{pad}{{}}\n"
        out = ""
        for key, value in data.items():
            if isinstance(value, (dict, list)):
                out += f"{pad}{key}:" + (
                    f"\n{yaml_dump(value, indent + 1)}" if value
                    else (" {}\n" if isinstance(value, dict) else " []\n")
                )
            else:
                out += f"{pad}{key}: {_yaml_scalar(value)}\n"
        return out
    if isinstance(data, list):
        if not data:
            return f"{pad}[]\n"
        out = ""
        for item in data:
            if isinstance(item, (dict, list)):
                if not item:
                    out += f"{pad}- " + ("{}\n" if isinstance(item, dict) else "[]\n")
                    continue
                lines = yaml_dump(item, indent + 1).rstrip("\n").split("\n")
                out += f"{pad}- {lines[0].lstrip()}\n"
                for line in lines[1:]:
                    out += f"{line}\n"
            else:
                out += f"{pad}- {_yaml_scalar(item)}\n"
        return out
    return f"{pad}{_yaml_scalar(data)}\n"


def _yaml_find(lines: list[str], key: str, indent: int, lo: int, hi: int) -> int | None:
    head = re.compile(rf"^{' ' * indent}{re.escape(key)}\s*:")
    for i in range(lo, hi):
        if head.match(lines[i]):
            return i
    return None


def _yaml_extent(lines: list[str], start: int, indent: int, hi: int) -> int:
    """Index one past the last line belonging to the mapping opened at `start`."""
    end = start + 1
    while end < hi:
        line = lines[end]
        if line.strip() == "" or len(line) - len(line.lstrip()) > indent:
            end += 1
            continue
        break
    return end


def yaml_upsert(text: str, path: list[str], value) -> str:
    """Set the mapping at `path` to `value`, preserving every sibling key at
    every level. Only the nesting depths Hermes needs (1 and 2) are supported.
    """
    lines = text.splitlines()
    lo, hi, indent = 0, len(lines), 0
    for depth, key in enumerate(path):
        last = depth == len(path) - 1
        idx = _yaml_find(lines, key, indent, lo, hi)
        block = yaml_dump({key: value}, indent // 2).rstrip("\n").splitlines()
        if idx is None:
            if last:
                lines = lines[:hi] + block + lines[hi:]
                break
            # Parent missing: create it with the whole remaining path inside.
            nested: dict = value
            for part in reversed(path[depth + 1:]):
                nested = {part: nested}
            lines = lines[:hi] + yaml_dump({key: nested}, indent // 2).rstrip("\n").splitlines() + lines[hi:]
            break
        if not last:
            # A parent written inline (`providers: {}`) has no indented block to
            # descend into; appending children under it produces invalid YAML.
            inline = lines[idx].partition(":")[2].split("#", 1)[0].strip()
            if inline in ("{}", "null", "~"):
                lines[idx] = f"{' ' * indent}{key}:"
            elif inline:
                # A populated inline mapping cannot be merged into as text.
                nested: dict = value
                for part in reversed(path[depth + 1:]):
                    nested = {part: nested}
                lines = lines[:idx] + yaml_dump({key: nested}, indent // 2).rstrip("\n").splitlines() + lines[idx + 1:]
                break
        end = _yaml_extent(lines, idx, indent, hi)
        if last:
            lines = lines[:idx] + block + lines[end:]
            break
        lo, hi, indent = idx + 1, end, indent + 2
    out = "\n".join(lines)
    return out if out.endswith("\n") else out + "\n"


def yaml_has_key(text: str, key: str) -> bool:
    return _yaml_find(text.splitlines(), key, 0, 0, len(text.splitlines())) is not None


# TOML ------------------------------------------------------------------------
#
# Only the ChatGPT desktop app needs TOML editing: it reads the ROOT table of
# ~/.codex/config.toml. `sah codex` writes a self-contained profile file it owns
# outright (Ollama's design), so it needs generation, not editing.


def toml_validate(text: str, path: Path) -> None:
    if tomllib is None:
        return
    try:
        tomllib.loads(text)
    except Exception as exc:  # tomllib.TOMLDecodeError, or tomli's
        sys.exit(f"refusing to write invalid TOML to {path}: {exc}")


def toml_set_root(text: str, key: str, value: str) -> str:
    """Set a root-table `key = value` (value already TOML-encoded)."""
    lines = text.splitlines(keepends=True)
    root_end = next((i for i, ln in enumerate(lines) if ln.lstrip().startswith("[")), len(lines))
    assignment = f"{key} = {value}"
    for i in range(root_end):
        stripped = lines[i].strip()
        if not stripped or stripped.startswith("#"):
            continue
        if re.match(rf"{re.escape(key)}\s*=", stripped):
            lines[i] = assignment + ("\n" if lines[i].endswith("\n") else "")
            return "".join(lines)
    head, tail = "".join(lines[:root_end]), "".join(lines[root_end:])
    head = head.rstrip("\n")
    if head:
        head += "\n"
    return head + assignment + "\n" + ("\n" + tail if tail else "")


def toml_set_root_string(text: str, key: str, value: str) -> str:
    return toml_set_root(text, key, json.dumps(str(value)))


def toml_remove_root(text: str, key: str) -> str:
    out, in_root = [], True
    for line in text.split("\n"):
        stripped = line.strip()
        if stripped.startswith("["):
            in_root = False
        if in_root and re.match(rf"{re.escape(key)}\s*=", stripped):
            continue
        out.append(line)
    return "\n".join(out)


def toml_upsert_section(text: str, header: str, lines: list[str]) -> str:
    block = "\n".join([header, *lines]) + "\n"
    idx = text.find(header)
    if idx >= 0:
        rest = text[idx + len(header):]
        end = rest.find("\n[")
        return text[:idx] + block + (rest[end + 1:] if end >= 0 else "")
    if text and not text.endswith("\n"):
        text += "\n"
    return text + ("\n" if text else "") + block


def toml_remove_section(text: str, header: str) -> str:
    idx = text.find(header)
    if idx < 0:
        return text
    rest = text[idx + len(header):]
    end = rest.find("\n[")
    return text[:idx] + (rest[end + 1:] if end >= 0 else "")


# ------------------------------------------------------------ backup / restore


def backup_path(label: str) -> Path:
    return CONFIG_DIR / f"{label}-settings.backup.json"


def backup_once(label: str, path: Path) -> None:
    """Record a client config file before sah first rewrites it. The first
    backup wins, so re-running --install never captures sah's own output."""
    target = backup_path(label)
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if target.is_file():
        return
    write_json(target, {
        "settings_path": str(path),
        "existed": path.is_file(),
        "content": path.read_text() if path.is_file() else "",
    })


def restore_backup(label: str, default_path: Path) -> bool:
    target = backup_path(label)
    if not target.is_file():
        return False
    try:
        saved = json.loads(target.read_text())
    except json.JSONDecodeError:
        sys.exit(f"{label} backup is unreadable: {target}")
    path = Path(saved.get("settings_path") or default_path)
    if saved.get("existed"):
        write_text(path, saved.get("content") or "")
    elif path.is_file():
        path.unlink()
    target.unlink()
    return True


# =============================================================== integrations
#
# One class per integration. The base class provides the whole lifecycle:
#
#   sah <name>              configure (if the client has a config) and exec it
#   sah <name> --install    configure only, so the plain client uses the Hub
#   sah <name> --restore    put the client's original config back
#   sah <name> --status     show whether the plain client is wired
#
# Subclasses override only what differs: which files they own, how to render
# them, and how the binary is invoked. Following Ollama, a bare launch of a
# config-file client DOES write that client's config (Ollama's Editor/Configure
# runs before Run); sah previously kept a private mirror of every client's
# state directory to avoid that, which was ~200 lines of machinery and a
# constant source of divergence between the mirrored and real config.


class Integration:
    name = ""
    display = ""
    aliases: tuple[str, ...] = ()
    kind = "CLI"
    binary: str | None = None
    install_hint = ""
    launchable = True   # bare `sah <name>` runs the client
    writes_config = False   # has a plain-client config → --install/--restore

    # -- binary ---------------------------------------------------------------

    def find_binary(self) -> str | None:
        return shutil.which(self.binary) if self.binary else None

    def require_binary(self) -> str:
        path = self.find_binary()
        if not path:
            sys.exit(f"{self.binary} not found in PATH. Install: {self.install_hint}")
        return path

    def availability(self) -> str:
        if not self.binary:
            return "n/a"
        return "yes" if self.find_binary() else "missing"

    def supported(self) -> str | None:
        """Non-None means this integration cannot run here; the string says why."""
        return None

    # -- config ---------------------------------------------------------------

    def files(self) -> dict[str, Path]:
        """Backup label -> plain-client config file that sah rewrites."""
        return {}

    def configure(self, model: Model) -> None:
        """Write the Hub wiring into the client's own config."""

    def wired(self) -> bool:
        return False

    def extras(self) -> tuple[tuple[str, str], ...]:
        return ()

    # -- launch ---------------------------------------------------------------

    def env(self, model: Model) -> dict:
        return {}

    def argv(self, model: Model, extra: list[str]) -> list[str]:
        return list(extra)

    def launch(self, model: Model, extra: list[str]) -> None:
        path = self.require_binary()
        if self.writes_config:
            self.apply(model)
        env = {**os.environ, **self.env(model)}
        os.execve(path, [self.binary or path, *self.argv(model, extra)], env)

    # -- lifecycle ------------------------------------------------------------

    def apply(self, model: Model) -> None:
        for label, path in self.files().items():
            backup_once(label, path)
        self.configure(model)

    def install(self, model: Model) -> None:
        self.apply(model)
        files = self.files()
        print(f"{self.display} wired to {PROVIDER_NAME}.")
        for _, path in files.items():
            kv("  Config", str(path))
        kv("  Model", model.name)
        for key, value in self.extras():
            kv(f"  {key}", value)
        if self.binary:
            print(f"  Plain `{self.binary}` will use the Hub until: sah {self.name} --restore")

    def restore(self) -> None:
        restored = [
            label for label, path in self.files().items() if restore_backup(label, path)
        ]
        if not restored:
            print(f"No {PROVIDER_NAME} {self.name} backup found; nothing to restore.")
            return
        print(f"{self.display} restored.")
        if self.binary:
            print(f"  Plain `{self.binary}` no longer uses the {PROVIDER_NAME} profile.")

    def status(self) -> None:
        if reason := self.supported():
            kv(f"{self.display} status", reason)
            return
        if self.binary:
            kv(f"{self.binary} binary", self.find_binary() or "not found in PATH")
        kv("OpenAI base", api_base())
        files = self.files()
        if not files:
            kv("Mode", "launch only (plain client settings untouched)")
            kv("Launch", f"sah {self.name}")
            for key, value in self.extras():
                kv(key, value)
            return
        for label, path in files.items():
            kv(f"{self.display} config", str(path))
            kv("  SAH backup", "present" if backup_path(label).is_file() else "not present")
        kv(f"Plain {self.binary or self.name}",
           f"wired to {PROVIDER_NAME}" if self.wired() else f"not wired to {PROVIDER_NAME}")
        for key, value in self.extras():
            kv(key, value)

    # -- CLI hooks ------------------------------------------------------------

    def add_arguments(self, parser) -> None:
        """Extra flags beyond --install/--restore/--status."""

    def run(self, args) -> None:
        if reason := self.supported():
            sys.exit(reason)
        if args.status:
            self.status()
            return
        if args.restore:
            if not self.writes_config:
                sys.exit(f"{self.display} is launch only in sah: it is configured per "
                         f"invocation and never writes the plain client's settings.")
            self.restore()
            return
        if args.install:
            if not self.writes_config:
                sys.exit(f"{self.display} is launch only in sah: it is configured per "
                         f"invocation, so there is nothing to install.\n"
                         f"Just run: sah {self.name}")
            self.install(require_model())
            return
        if not self.launchable:
            sys.exit(f"Choose one: sah {self.name} --install, --status, or --restore")
        self.launch(require_model(), normalize_passthrough(args.passthrough))


def normalize_passthrough(args: list[str]) -> list[str]:
    return args[1:] if args and args[0] == "--" else args


def reject_managed_flags(extra: list[str], names: tuple[str, ...], owner: str) -> None:
    for arg in extra:
        if arg.split("=", 1)[0] in names:
            sys.exit(f"conflicting argument {arg!r}: {owner} manages it")


def has_flag(extra: list[str], *names: str) -> bool:
    return any(a.split("=", 1)[0] in names for a in extra)


# ---------------------------------------------------------------------- claude


class Claude(Integration):
    """Ollama's cmd/launch/claude.go: env vars only, nothing written to disk.

    sah used to also rewrite ~/.claude/settings.json under --install; Ollama
    does not, and the env vars alone are sufficient, so that is gone.
    """
    name, display, binary = "claude", "Claude Code", "claude"
    install_hint = "https://code.claude.com/docs/en/quickstart"

    def find_binary(self) -> str | None:
        if path := shutil.which("claude"):
            return path
        for fallback in (Path.home() / ".local/bin/claude", Path.home() / ".claude/local/claude"):
            if fallback.is_file():
                return str(fallback)
        return None

    def env(self, model: Model) -> dict:
        return {
            "ANTHROPIC_BASE_URL": hub_url(),
            "ANTHROPIC_API_KEY": "",
            "ANTHROPIC_AUTH_TOKEN": API_KEY,
            "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
            "DISABLE_ERROR_REPORTING": "1",
            "DISABLE_FEEDBACK_COMMAND": "1",
            "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
            "ANTHROPIC_DEFAULT_OPUS_MODEL": model.name,
            "ANTHROPIC_DEFAULT_SONNET_MODEL": model.name,
            "ANTHROPIC_DEFAULT_HAIKU_MODEL": model.name,
            "CLAUDE_CODE_SUBAGENT_MODEL": model.name,
        }

    def argv(self, model: Model, extra: list[str]) -> list[str]:
        return ["--model", model.name, *extra]


# -------------------------------------------------------------------- opencode


class OpenCode(Integration):
    """Ollama's cmd/launch/opencode.go: the whole provider config is handed to
    OpenCode inline through OPENCODE_CONFIG_CONTENT, so opencode.json is never
    touched. Only the model-picker state file is written, so Hub models show up
    in the picker."""
    name, display, binary = "opencode", "OpenCode", "opencode"
    install_hint = "https://opencode.ai"

    def find_binary(self) -> str | None:
        if path := shutil.which("opencode"):
            return path
        fallback = Path.home() / ".opencode/bin/opencode"
        return str(fallback) if fallback.is_file() else None

    def state_path(self) -> Path:
        return Path.home() / ".local/state/opencode/model.json"

    def inline_config(self, model: Model) -> str:
        entry: dict = {"name": model.name}
        if model.has("vision"):
            entry["modalities"] = {"input": model.input_modalities(), "output": ["text"]}
        if model.has("thinking"):
            entry["reasoning"] = True
        if model.context_length:
            entry["limit"] = {"context": model.context_length, "output": model.max_output()}
        return json.dumps({
            "$schema": "https://opencode.ai/config.json",
            "provider": {
                PROVIDER: {
                    "npm": "@ai-sdk/openai-compatible",
                    "name": PROVIDER_NAME,
                    "options": {"baseURL": api_base()},
                    "models": {model.name: entry},
                }
            },
            "model": f"{PROVIDER}/{model.name}",
        })

    def _touch_picker_state(self, model: Model) -> None:
        path = self.state_path()
        state = read_json(path) or {"recent": [], "favorite": [], "variant": {}}
        recent = [
            e for e in (state.get("recent") or [])
            if not (isinstance(e, dict) and e.get("providerID") == PROVIDER
                    and e.get("modelID") == model.name)
        ]
        state["recent"] = [{"providerID": PROVIDER, "modelID": model.name}, *recent][:10]
        write_json(path, state)

    def env(self, model: Model) -> dict:
        self._touch_picker_state(model)
        return {"OPENCODE_CONFIG_CONTENT": self.inline_config(model)}

    def extras(self) -> tuple[tuple[str, str], ...]:
        return (("Picker state", str(self.state_path())),)


# ----------------------------------------------------------------------- codex


CODEX_PROFILE = "sah"


class Codex(Integration):
    """Ollama's cmd/launch/codex.go: a self-contained profile file that sah owns
    outright plus `codex --profile sah`. The user's root config.toml is never
    read or written, so there is no backup, no restore state, and no way for
    this to collide with `sah chatgpt` (which does write the root table).

    sah previously wrote root keys via -c overrides and --install; that is what
    made codex and chatgpt fight over the same file.
    """
    name, display, binary = "codex", "Codex", "codex"
    install_hint = "npm install -g @openai/codex"

    def codex_dir(self) -> Path:
        return Path.home() / ".codex"

    def profile_path(self) -> Path:
        return self.codex_dir() / f"{CODEX_PROFILE}.config.toml"

    def catalog_path(self) -> Path:
        return self.codex_dir() / f"{CODEX_PROFILE}-model.json"

    def base_url(self) -> str:
        return api_base().rstrip("/") + "/"

    def catalog_entry(self, model: Model) -> dict:
        return {
            "slug": model.name,
            "display_name": model.name,
            "context_window": model.context(128000),
            "shell_type": "default",
            "visibility": "list",
            "supported_in_api": True,
            "priority": 0,
            "truncation_policy": {"mode": "bytes", "limit": 10000},
            "input_modalities": model.input_modalities(),
            "base_instructions": "",
            "support_verbosity": True,
            "default_verbosity": "low",
            "supports_parallel_tool_calls": False,
            "supports_reasoning_summaries": False,
            "supported_reasoning_levels": [],
            "experimental_supported_tools": [],
        }

    def write_profile(self, model: Model) -> None:
        catalog = self.catalog_path()
        write_json(catalog, {"models": [self.catalog_entry(model)]})
        text = "\n".join([
            f"model = {json.dumps(model.name)}",
            f"model_provider = {json.dumps(CODEX_PROFILE)}",
            f"model_catalog_json = {json.dumps(str(catalog))}",
            "",
            f"[model_providers.{CODEX_PROFILE}]",
            f"name = {json.dumps(PROVIDER_NAME)}",
            f"base_url = {json.dumps(self.base_url())}",
            'wire_api = "responses"',
            "",
        ])
        toml_validate(text, self.profile_path())
        write_text(self.profile_path(), text)

    # Codex only loads `~/.codex/<profile>.config.toml` from this version on;
    # before it, --profile resolves against the root config.toml only, which is
    # exactly the file this design refuses to touch. Ollama gates on the same
    # version for the same reason (checkCodexVersion).
    MIN_VERSION = (0, 134, 0)

    def check_version(self, path: str) -> None:
        result = subprocess.run([path, "--version"], capture_output=True, text=True)
        fields = result.stdout.split()
        if not fields:
            return
        raw = fields[-1]
        try:
            parts = tuple(int(p) for p in raw.split(".")[:3])
        except ValueError:
            return
        if parts < self.MIN_VERSION:
            sys.exit(
                f"codex {raw} is too old for sah: profile config files need "
                f"{'.'.join(str(p) for p in self.MIN_VERSION)} or newer.\n"
                f"Update with: npm update -g @openai/codex"
            )

    def config_overrides(self) -> list[str]:
        """The same settings as the profile file, passed on the command line.
        Ollama sends both so a launch works even if the profile file is not
        picked up."""
        return [
            "-c", f"model_provider={json.dumps(CODEX_PROFILE)}",
            "-c", f"model_providers.{CODEX_PROFILE}.name={json.dumps(PROVIDER_NAME)}",
            "-c", f"model_providers.{CODEX_PROFILE}.base_url={json.dumps(self.base_url())}",
            "-c", f'model_providers.{CODEX_PROFILE}.wire_api="responses"',
            "-c", f"model_catalog_json={json.dumps(str(self.catalog_path()))}",
        ]

    def launch(self, model: Model, extra: list[str]) -> None:
        reject_managed_flags(extra, ("--profile", "-p", "--model", "-m"), "sah codex")
        path = self.require_binary()
        self.check_version(path)
        self.write_profile(model)
        env = {**os.environ, "OPENAI_API_KEY": API_KEY}
        argv = ["codex", "--profile", CODEX_PROFILE, *self.config_overrides(),
                "-m", model.name, *extra]
        os.execve(path, argv, env)

    # Codex owns only files sah created, so install/restore are create/delete
    # rather than rewrite/put-back.
    writes_config = True

    def files(self) -> dict[str, Path]:
        return {}

    def apply(self, model: Model) -> None:
        self.write_profile(model)

    def install(self, model: Model) -> None:
        self.write_profile(model)
        print(f"{self.display} wired to {PROVIDER_NAME}.")
        kv("  Profile", str(self.profile_path()))
        kv("  Model catalog", str(self.catalog_path()))
        kv("  Model", model.name)
        print(f"  Launch with: codex --profile {CODEX_PROFILE}   (or: sah codex)")

    def restore(self) -> None:
        removed = False
        for path in (self.profile_path(), self.catalog_path()):
            if path.is_file():
                path.unlink()
                removed = True
        print(f"{self.display} launch configuration removed."
              if removed else
              f"No {PROVIDER_NAME} codex configuration found; nothing to restore.")

    def wired(self) -> bool:
        return self.profile_path().is_file()

    def status(self) -> None:
        kv("Codex profile", str(self.profile_path()))
        kv("Model catalog", str(self.catalog_path()))
        kv("Root config.toml", "untouched by sah codex")
        kv("Profile present", "yes" if self.wired() else "no")
        kv("OpenAI base", api_base())


# ---------------------------------------------------------------------- qwen


class Qwen(Integration):
    """Ollama's cmd/launch/qwen.go: env + `--auth-type openai --model`, and a
    Configure() that writes ~/.qwen/settings.json."""
    name, display, binary = "qwen", "Qwen Code", "qwen"
    install_hint = "https://qwen.ai/qwencode"
    writes_config = True

    def config_path(self) -> Path:
        return Path.home() / ".qwen" / "settings.json"

    def files(self) -> dict[str, Path]:
        return {"qwen": self.config_path()}

    def configure(self, model: Model) -> None:
        cfg = read_json(self.config_path())
        env_cfg = cfg.get("env") if isinstance(cfg.get("env"), dict) else {}
        env_cfg["SAH_API_KEY"] = API_KEY
        cfg["env"] = env_cfg

        providers = cfg.get("modelProviders") if isinstance(cfg.get("modelProviders"), dict) else {}
        mine = {
            "id": model.name,
            "name": f"{model.name} ({PROVIDER_NAME})",
            "baseUrl": api_base(),
            "envKey": "SAH_API_KEY",
        }
        others = [
            p for p in (providers.get("openai") or [])
            if not (isinstance(p, dict) and p.get("envKey") == "SAH_API_KEY")
        ]
        providers["openai"] = [mine, *others]
        cfg["modelProviders"] = providers

        security = cfg.get("security") if isinstance(cfg.get("security"), dict) else {}
        auth = security.get("auth") if isinstance(security.get("auth"), dict) else {}
        auth["selectedType"] = "openai"
        auth["baseUrl"] = api_base()
        security["auth"] = auth
        cfg["security"] = security

        model_cfg = cfg.get("model") if isinstance(cfg.get("model"), dict) else {}
        model_cfg["name"] = model.name
        cfg["model"] = model_cfg
        write_json(self.config_path(), cfg)

    def wired(self) -> bool:
        cfg = read_json(self.config_path())
        auth = (cfg.get("security") or {}).get("auth") or {}
        return auth.get("baseUrl") == api_base()

    def env(self, model: Model) -> dict:
        return {
            "OPENAI_API_KEY": API_KEY,
            "OPENAI_BASE_URL": api_base(),
            "OPENAI_MODEL": model.name,
            "SAH_API_KEY": API_KEY,
        }

    def argv(self, model: Model, extra: list[str]) -> list[str]:
        args = list(extra)
        if not has_flag(args, "--auth-type"):
            args = ["--auth-type", "openai", *args]
        if not has_flag(args, "--model", "-m"):
            args = ["--model", model.name, *args]
        return args


# --------------------------------------------------------------------- hermes


class Hermes(Integration):
    """Ollama's cmd/launch/hermes.go: providers.<key> + model defaults in
    ~/.hermes/config.yaml, then run the binary.

    DIVERGENCE (platform, not preference): Ollama merges that YAML with a real
    parser. sah is stdlib-only, so it does targeted block replacement — which
    preserves sibling keys but cannot merge inside the blocks it owns.
    """
    name, display, binary = "hermes", "Hermes Agent", "hermes"
    install_hint = "https://hermes-agent.nousresearch.com/docs/getting-started/installation/"
    writes_config = True

    def hermes_home(self) -> Path:
        if home := os.environ.get("HERMES_HOME", "").strip():
            return Path(home)
        return Path.home() / ".hermes"

    def config_path(self) -> Path:
        return self.hermes_home() / "config.yaml"

    def files(self) -> dict[str, Path]:
        return {"hermes": self.config_path()}

    def find_binary(self) -> str | None:
        if path := shutil.which("hermes"):
            return path
        fallback = Path.home() / ".local/bin/hermes"
        return str(fallback) if fallback.is_file() else None

    def configure(self, model: Model) -> None:
        path = self.config_path()
        text = path.read_text() if path.is_file() else ""
        text = yaml_upsert(text, ["providers", PROVIDER], {
            "name": PROVIDER_NAME,
            "api": api_base(),
            "default_model": model.name,
            "models": [model.name],
        })
        text = yaml_upsert(text, ["model"], {
            "provider": PROVIDER,
            "default": model.name,
            "base_url": api_base(),
            "api_key": API_KEY,
        })
        # Ollama merges "web" into any existing toolsets; block replacement
        # would drop the user's, so only seed the key when it is absent.
        if not yaml_has_key(text, "toolsets"):
            text = yaml_upsert(text, ["toolsets"], ["hermes-cli", "web"])
        write_text(path, text)

    def wired(self) -> bool:
        path = self.config_path()
        text = path.read_text() if path.is_file() else ""
        return f'base_url: "{api_base()}"' in text and f'provider: "{PROVIDER}"' in text


class HermesDesktop(Hermes):
    """Same agent, same ~/.hermes/config.yaml, driven through `hermes desktop`.
    `--skip-build` is added when a packaged desktop app already exists, exactly
    as Ollama's HermesDesktop.launchArgs does."""
    name, display = "hermes-desktop", "Hermes Desktop"
    kind = "Desktop"

    _BUILD_FLAGS = ("--skip-build", "--force-build", "--source", "--build-only", "--help", "-h")

    def release_roots(self) -> list[str]:
        roots = []
        if d := os.environ.get("HERMES_INSTALL_DIR", "").strip():
            roots.append(Path(d))
        roots.append(self.hermes_home() / "hermes-agent")
        if sys.platform.startswith("linux"):
            roots.append(Path("/usr/local/lib/hermes-agent"))
        return [str(r / "apps" / "desktop" / "release") for r in roots]

    def packaged_app_exists(self) -> bool:
        for root in self.release_roots():
            base = Path(root)
            if sys.platform == "darwin":
                if any(base.glob("mac*/Hermes.app/Contents/MacOS/Hermes")):
                    return True
            elif sys.platform == "win32":
                if any((base / d / "Hermes.exe").is_file()
                       for d in ("win-unpacked", "win-ia32-unpacked", "win-arm64-unpacked")):
                    return True
            else:
                if any((base / "linux-unpacked" / n).is_file() for n in ("hermes", "Hermes")):
                    return True
        return False

    def argv(self, model: Model, extra: list[str]) -> list[str]:
        args = ["desktop"]
        if not any(a in self._BUILD_FLAGS for a in extra) and self.packaged_app_exists():
            args.append("--skip-build")
        return [*args, *extra]


# ------------------------------------------------------------------- openclaw


class OpenClaw(Integration):
    """Ollama's cmd/launch/openclaw.go: models.providers.<id> plus
    agents.defaults.model.primary in ~/.openclaw/openclaw.json, then the
    gateway lifecycle around the TUI.

    sah used to run OpenClaw under a private `--profile sah` with a mirrored
    state directory so the user's own OpenClaw stayed untouched. Ollama edits
    the real config; that is what sah does now, with a backup so --restore puts
    the original back.
    """
    name, display, binary = "openclaw", "OpenClaw", "openclaw"
    aliases = ("clawdbot", "moltbot")
    install_hint = "https://docs.openclaw.ai"
    writes_config = True

    _CLEAR_KEYS = (
        "ANTHROPIC_API_KEY", "ANTHROPIC_OAUTH_TOKEN", "OPENAI_API_KEY", "GEMINI_API_KEY",
        "MISTRAL_API_KEY", "GROQ_API_KEY", "XAI_API_KEY", "OPENROUTER_API_KEY",
    )

    def find_binary(self) -> str | None:
        return shutil.which("openclaw") or shutil.which("clawdbot")

    def config_path(self) -> Path:
        return Path.home() / ".openclaw" / "openclaw.json"

    def legacy_path(self) -> Path:
        return Path.home() / ".clawdbot" / "clawdbot.json"

    def files(self) -> dict[str, Path]:
        return {"openclaw": self.config_path()}

    def configure(self, model: Model) -> None:
        path = self.config_path()
        cfg = read_json(path) or read_json(self.legacy_path())

        models_section = cfg.get("models") if isinstance(cfg.get("models"), dict) else {}
        providers = models_section.get("providers") if isinstance(models_section.get("providers"), dict) else {}
        provider = providers.get(PROVIDER) if isinstance(providers.get(PROVIDER), dict) else {}
        provider["baseUrl"] = api_base()
        provider["apiKey"] = API_KEY
        provider["api"] = "openai-completions"
        entry: dict = {
            "id": model.name,
            "name": model.name,
            "input": model.input_modalities(),
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
        }
        if model.has("thinking"):
            entry["reasoning"] = True
        if model.context_length:
            entry["contextWindow"] = model.context_length
            entry["maxTokens"] = model.max_output()
        provider["models"] = [entry]
        providers[PROVIDER] = provider
        models_section["providers"] = providers
        cfg["models"] = models_section

        agents = cfg.get("agents") if isinstance(cfg.get("agents"), dict) else {}
        defaults = agents.get("defaults") if isinstance(agents.get("defaults"), dict) else {}
        model_cfg = defaults.get("model") if isinstance(defaults.get("model"), dict) else {}
        model_cfg["primary"] = f"{PROVIDER}/{model.name}"
        defaults["model"] = model_cfg
        agents["defaults"] = defaults
        cfg["agents"] = agents

        write_json(path, cfg)
        self._clear_session_overrides(model.name)

    def _clear_session_overrides(self, primary: str) -> None:
        """Per-session overrides shadow the new primary model until cleared —
        Ollama's clearSessionModelOverride."""
        path = Path.home() / ".openclaw/agents/main/sessions/sessions.json"
        sessions = read_json(path)
        if not sessions:
            return
        changed = False
        for session in sessions.values():
            if not isinstance(session, dict):
                continue
            if session.pop("modelOverride", None) is not None:
                session.pop("providerOverride", None)
                changed = True
            if session.get("model") not in (None, primary):
                session["model"] = primary
                changed = True
        if changed:
            write_json(path, sessions)

    def wired(self) -> bool:
        cfg = read_json(self.config_path())
        providers = ((cfg.get("models") or {}).get("providers") or {})
        provider = providers.get(PROVIDER)
        return isinstance(provider, dict) and provider.get("baseUrl") == api_base()

    def env(self, model: Model) -> dict:
        env = {k: v for k, v in os.environ.items() if k not in self._CLEAR_KEYS}
        env["OPENAI_API_KEY"] = API_KEY
        env["OPENAI_BASE_URL"] = api_base()
        env.setdefault("OPENCLAW_PLUGIN_STAGE_DIR",
                       str(Path.home() / ".openclaw" / "plugin-runtime-deps"))
        return env

    def gateway_info(self) -> tuple[str, int]:
        for path in (self.config_path(), self.legacy_path()):
            cfg = read_json(path)
            gateway = cfg.get("gateway") if isinstance(cfg, dict) else None
            if not isinstance(gateway, dict):
                continue
            port = 18789
            try:
                port = int(gateway.get("port") or port)
            except (TypeError, ValueError):
                pass
            auth = gateway.get("auth")
            token = auth.get("token", "") if isinstance(auth, dict) else ""
            return (token if isinstance(token, str) else ""), port
        return "", 18789

    def launch(self, model: Model, extra: list[str]) -> None:
        binary = self.require_binary()
        self.apply(model)
        env = self.env(model)
        token, port = self.gateway_info()
        gateway = None
        # Ollama only brings the gateway up for the TUI flow; with any other
        # passthrough args it runs exactly what the user asked for.
        needs_gateway = not extra or extra[0] == "tui"
        if not needs_gateway:
            sys.exit(subprocess.run([binary, *extra], env=env).returncode)
        if not port_open(port):
            gateway = subprocess.Popen(
                [binary, "gateway", "run", "--force"],
                env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            if not wait_port(port, 30):
                _terminate(gateway)
                sys.exit(f"openclaw gateway did not start on 127.0.0.1:{port}")
        cmd = [binary, *(extra or ["tui"])]
        if token and not has_flag(extra, "--token"):
            cmd += ["--token", token]
        if not has_flag(extra, "--url"):
            cmd += ["--url", f"ws://127.0.0.1:{port}"]
        try:
            sys.exit(subprocess.run(cmd, env=env).returncode)
        finally:
            _terminate(gateway)


def port_open(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.settimeout(0.5)
        return sock.connect_ex(("127.0.0.1", port)) == 0


def wait_port(port: int, timeout: float) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        if port_open(port):
            return True
        time.sleep(0.25)
    return False


def _terminate(proc) -> None:
    if proc is None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        proc.kill()


