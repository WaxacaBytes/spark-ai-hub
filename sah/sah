class Cline(Integration):
    """Ollama's cmd/launch/cline.go writes Cline's built-in `ollama` provider,
    which reaches models through an Ollama server. sah points Cline's built-in
    `openai-compatible` provider at the Hub instead — it must be a built-in id,
    because Cline validates the provider against its own registry and rejects
    anything else with "Unknown or disabled provider".

    Both config surfaces are written, as Ollama does: the current
    providers.json and the legacy globalState.json, which calls the same
    provider `openai`."""
    name, display, binary = "cline", "Cline", "cline"
    install_hint = "npm install -g cline@latest"
    writes_config = True

    CLINE_PROVIDER = "openai-compatible"

    def state_dir(self) -> Path:
        if d := os.environ.get("CLINE_DIR", "").strip():
            return Path(d)
        return Path.home() / ".cline"

    def files(self) -> dict[str, Path]:
        root = self.state_dir()
        return {
            "cline": root / "data" / "settings" / "providers.json",
            "cline-state": root / "data" / "globalState.json",
        }

    def configure(self, model: Model) -> None:
        paths = self.files()
        config = read_json(paths["cline"])
        capabilities = ["streaming", "tools"]
        if model.has("vision"):
            capabilities.append("vision")
        providers = config.get("providers") if isinstance(config.get("providers"), dict) else {}
        entry = providers.get(self.CLINE_PROVIDER)
        entry = entry if isinstance(entry, dict) else {}
        settings = {
            "provider": self.CLINE_PROVIDER,
            "client": "openai-compatible",
            "protocol": "openai-chat",
            "baseUrl": api_base(),
            "apiKey": API_KEY,
            "model": model.name,
            "capabilities": capabilities,
        }
        if model.context_length:
            settings["contextWindow"] = model.context_length
            settings["maxTokens"] = model.max_output()
        entry["settings"] = settings
        entry["tokenSource"] = "manual"
        entry["updatedAt"] = rfc3339_now()
        providers[self.CLINE_PROVIDER] = entry
        config["version"] = 1
        config.setdefault("modes", {})
        config["lastUsedProvider"] = self.CLINE_PROVIDER
        config["providers"] = providers
        write_json(paths["cline"], config)

        state = read_json(paths["cline-state"])
        state["openAiBaseUrl"] = api_base()
        state["openAiApiKey"] = API_KEY
        for mode in ("actMode", "planMode"):
            state[f"{mode}ApiProvider"] = "openai"
            state[f"{mode}OpenAiModelId"] = model.name
        state["welcomeViewCompleted"] = True
        write_json(paths["cline-state"], state)

    def wired(self) -> bool:
        config = read_json(self.files()["cline"])
        provider = (config.get("providers") or {}).get(self.CLINE_PROVIDER)
        settings = provider.get("settings") if isinstance(provider, dict) else None
        return (config.get("lastUsedProvider") == self.CLINE_PROVIDER
                and isinstance(settings, dict) and settings.get("baseUrl") == api_base())


