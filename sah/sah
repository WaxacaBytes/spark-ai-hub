    redirected, for this invocation, to an sah-owned document passed as
    --patch. The user's DSH_HOME, profiles, sessions and credentials are
    untouched."""
    name, display, binary = "dsh", "DeepSeek Harness", "dsh"
    aliases = ("deepseek-harness",)
    install_hint = "npm install -g @deepseek-ai/dsh"

    API_KEY_ENV = "SAH_DSH_API_KEY"

    def config_dir(self) -> Path:
        return CONFIG_DIR / "dsh"

    def settings_path(self) -> Path:
        return self.config_dir() / "settings.yaml"

    def patch_path(self) -> Path:
        return self.config_dir() / "sah.cordis.yml"

    def settings(self, model: Model) -> dict:
        entry: dict = {
            "id": model.name,
            "name": model.name,
            "input": model.input_modalities(),
        }
        if model.context_length:
            entry["contextWindow"] = model.context_length
            entry["maxTokens"] = model.max_output()
        return {
            "agent-default-model": {"provider": PROVIDER, "model": model.name},
            "llm-pi-ai": {"providers": {PROVIDER: {
                "displayName": PROVIDER_NAME,
                "apiKeyEnv": self.API_KEY_ENV,
                "api": "openai-completions",
                "baseURL": api_base(),
                "models": [entry],
            }}},
        }

