SAH_PROFILE_ID = str(uuid.uuid5(uuid.NAMESPACE_DNS, "spark-ai-hub.sah"))
SAH_TUNNEL_PORT = 9009
SAH_LAUNCH_LABEL = "ai.waxacabytes.sah-tunnel"

SAH_TUNNEL_SCRIPT = '''#!/usr/bin/env python3
"""sah-tunnel — TCP forwarder: 127.0.0.1:<port> -> <hub host:port>."""
import asyncio, sys, urllib.parse


async def _pipe(reader, writer):
    try:
        while True:
            data = await reader.read(65536)
            if not data:
                break
            writer.write(data)
            await writer.drain()
    except (ConnectionError, OSError):
        pass
    finally:
        try:
            writer.close()
        except Exception:
            pass


async def _handle(client_r, client_w, host, port):
    try:
        upstream_r, upstream_w = await asyncio.open_connection(host, port)
    except (ConnectionError, OSError):
        client_w.close()
        return
    await asyncio.gather(_pipe(client_r, upstream_w), _pipe(upstream_r, client_w))


async def _main():
    listen_port = int(sys.argv[1])
    hub = urllib.parse.urlparse(sys.argv[2])
    host = hub.hostname or "127.0.0.1"
    port = hub.port or (443 if hub.scheme == "https" else 80)
    server = await asyncio.start_server(
        lambda r, w: _handle(r, w, host, port), "127.0.0.1", listen_port
    )
    async with server:
        await server.serve_forever()


if __name__ == "__main__":
    asyncio.run(_main())
'''


class ClaudeDesktop(Integration):
    """Ollama's cmd/launch/claude_desktop.go: deploymentMode=3p, a stable
    profile UUID, the same gateway keys, the same restore semantics.

    DIVERGENCE (environment, not preference): Claude Desktop's 3p mode requires
    an HTTPS gateway URL or http on 127.0.0.1. Ollama always satisfies that
    because its server IS localhost; the Hub is on the LAN over plain http, so
    sah installs a launchd-managed TCP forwarder on 127.0.0.1 and points Claude
    Desktop at that.
    """
    name, display = "claude-desktop", "Claude Desktop"
    aliases = ("claude-app",)
    kind = "Desktop"
    binary = None
    launchable = False
    writes_config = True

    def supported(self) -> str | None:
        if sys.platform != "darwin":
            return ("sah claude-desktop is macOS-only. Anthropic does not ship a Linux "
                    "build of Claude Desktop; run this on the Mac that has it installed.")
        return None

    def paths(self) -> dict:
        home = Path.home()
        base = home / "Library/Application Support"
        return {
            "normal_dir": base / "Claude",
            "third_party_dir": base / "Claude-3p",
            "tunnel_script": CONFIG_DIR / "sah-tunnel.py",
            "tunnel_log": CONFIG_DIR / "sah-tunnel.log",
            "plist": home / "Library/LaunchAgents" / f"{SAH_LAUNCH_LABEL}.plist",
        }

    def app_path(self) -> Path | None:
        for candidate in (Path("/Applications/Claude.app"), Path.home() / "Applications/Claude.app"):
            if candidate.is_dir():
                return candidate
        return None

    def running(self) -> bool:
        result = subprocess.run(["pgrep", "-f", "Claude.app/Contents/MacOS/Claude"],
                                capture_output=True, text=True)
        return result.returncode == 0 and bool(result.stdout.strip())

    def files(self) -> dict[str, Path]:
        return {}

    # -- tunnel ---------------------------------------------------------------

    def install_tunnel(self, hub: str) -> None:
        p = self.paths()
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        write_text(p["tunnel_script"], SAH_TUNNEL_SCRIPT)
        p["tunnel_script"].chmod(0o755)
        plist = (
            '<?xml version="1.0" encoding="UTF-8"?>\n'
            '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
            '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
            '<plist version="1.0">\n<dict>\n'
            f'    <key>Label</key><string>{SAH_LAUNCH_LABEL}</string>\n'
            '    <key>ProgramArguments</key>\n    <array>\n'
            '        <string>/usr/bin/python3</string>\n'
            f'        <string>{p["tunnel_script"]}</string>\n'
            f'        <string>{SAH_TUNNEL_PORT}</string>\n'
            f'        <string>{hub}</string>\n'
            '    </array>\n'
            '    <key>RunAtLoad</key><true/>\n'
            '    <key>KeepAlive</key><true/>\n'
            f'    <key>StandardOutPath</key><string>{p["tunnel_log"]}</string>\n'
            f'    <key>StandardErrorPath</key><string>{p["tunnel_log"]}</string>\n'
            '</dict>\n</plist>\n'
        )
        write_text(p["plist"], plist)
        subprocess.run(["launchctl", "unload", str(p["plist"])], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["launchctl", "load", str(p["plist"])], check=False)
        # Claude Desktop probes the gateway at startup and caches a failure if
        # the port is not ready, so wait for the socket before relaunching it.
        if not wait_port(SAH_TUNNEL_PORT, 5):
            print(f"warning: tunnel on 127.0.0.1:{SAH_TUNNEL_PORT} did not come up within 5s; "
                  f"check {p['tunnel_log']}", file=sys.stderr)

    def uninstall_tunnel(self) -> None:
        p = self.paths()
        if p["plist"].is_file():
            subprocess.run(["launchctl", "unload", str(p["plist"])], check=False,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            p["plist"].unlink()
        if p["tunnel_script"].is_file():
            p["tunnel_script"].unlink()

    # -- profile --------------------------------------------------------------

    def set_deployment_mode(self, mode: str) -> None:
        p = self.paths()
        for directory in (p["normal_dir"], p["third_party_dir"]):
            path = directory / "claude_desktop_config.json"
            cfg = read_json(path)
            if cfg.get("deploymentMode") == mode and path.is_file():
                continue
            cfg["deploymentMode"] = mode
            write_json(path, cfg)

    def write_profile(self) -> None:
        p = self.paths()
        path = p["third_party_dir"] / f"configLibrary/{SAH_PROFILE_ID}.json"
        cfg = read_json(path)
        cfg["inferenceProvider"] = "gateway"
        cfg["inferenceGatewayBaseUrl"] = f"http://127.0.0.1:{SAH_TUNNEL_PORT}"
        cfg["inferenceGatewayApiKey"] = API_KEY
        cfg["inferenceGatewayAuthScheme"] = "bearer"
        cfg["disableDeploymentModeChooser"] = True
        cfg.pop("inferenceModels", None)
        write_json(path, cfg)

        meta_path = p["third_party_dir"] / "configLibrary/_meta.json"
        meta = read_json(meta_path)
        entries = [e for e in (meta.get("entries") or []) if e.get("id") != SAH_PROFILE_ID]
        meta["entries"] = [*entries, {"id": SAH_PROFILE_ID, "name": PROVIDER_NAME}]
        meta["appliedId"] = SAH_PROFILE_ID
        write_json(meta_path, meta)

    def clear_profile(self) -> None:
        p = self.paths()
        meta_path = p["third_party_dir"] / "configLibrary/_meta.json"
        if meta := read_json(meta_path):
            if meta.get("appliedId") == SAH_PROFILE_ID:
                meta.pop("appliedId", None)
            meta["entries"] = [e for e in (meta.get("entries") or []) if e.get("id") != SAH_PROFILE_ID]
            write_json(meta_path, meta)
        path = p["third_party_dir"] / f"configLibrary/{SAH_PROFILE_ID}.json"
        # Ollama strips the gateway keys rather than deleting the profile:
        # deleting it leaves Claude Desktop with an applied-profile-is-gone
        # state that presents as a logged-out 3p screen.
        if cfg := read_json(path):
            cfg["disableDeploymentModeChooser"] = False
            for key in ("inferenceProvider", "inferenceGatewayBaseUrl",
                        "inferenceGatewayAuthScheme", "inferenceModels"):
                cfg.pop(key, None)
            write_json(path, cfg)

    def restart(self, skip: bool) -> None:
        if skip:
            print("Quit and reopen Claude Desktop for the change to take effect.")
            return
        if self.running():
            print("Restarting Claude Desktop", end="", flush=True)
            subprocess.run(["osascript", "-e", 'tell application "Claude" to quit'],
                           check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            deadline = time.time() + 30
            while time.time() < deadline and self.running():
                print(".", end="", flush=True)
                time.sleep(1.0)
            print(" done.")
            time.sleep(0.5)
        subprocess.run(["open", "-a", "Claude"], check=False)

    def status(self) -> None:
        p = self.paths()
        app = self.app_path()
        kv("Claude Desktop", f"installed at {app}" if app else "NOT installed")
        if not app:
            return
        cfg = read_json(p["third_party_dir"] / "claude_desktop_config.json")
        profile = read_json(p["third_party_dir"] / f"configLibrary/{SAH_PROFILE_ID}.json")
        meta = read_json(p["third_party_dir"] / "configLibrary/_meta.json")
        active = (cfg.get("deploymentMode") == "3p"
                  and meta.get("appliedId") == SAH_PROFILE_ID
                  and profile.get("inferenceProvider") == "gateway"
                  and p["plist"].is_file())
        kv("Deployment mode", cfg.get("deploymentMode", "1p (default)"))
        kv("SAH profile", "APPLIED" if active else "not applied")
        kv("Gateway URL", profile.get("inferenceGatewayBaseUrl", "—"))
        kv("Tunnel agent", f"{'loaded' if p['plist'].is_file() else 'not installed'} ({p['plist']})")
        kv("Claude running", "yes" if self.running() else "no")

    def add_arguments(self, parser) -> None:
        parser.add_argument("--no-restart", action="store_true",
                            help="Skip the automatic Claude Desktop restart")

    def run(self, args) -> None:
        if reason := self.supported():
            sys.exit(reason)
        if args.status:
            self.status()
            return
        if not args.install and not args.restore:
            sys.exit("Choose one: sah claude-desktop --install, --status, or --restore")
        if self.app_path() is None:
            sys.exit("Claude Desktop is not installed. Install it from "
                     "https://claude.ai/download, then re-run this command.")
        if args.restore:
            # Order matches Ollama: deploymentMode first, then unwind the
            # profile — Claude Desktop routes everything else off that.
            self.set_deployment_mode("1p")
            self.clear_profile()
            self.uninstall_tunnel()
            print(f"{PROVIDER_NAME} disconnected from Claude Desktop.")
            self.restart(skip=args.no_restart)
            return
        hub = hub_url()
        self.install_tunnel(hub)
        self.write_profile()
        self.set_deployment_mode("3p")
        print(f"{PROVIDER_NAME} wired to Claude Desktop.")
        kv("  Local proxy", f"127.0.0.1:{SAH_TUNNEL_PORT} → {hub}")
        print("  Restore with: sah claude-desktop --restore")
        self.restart(skip=args.no_restart)


# ------------------------------------------------------------------- registry
#
# Order mirrors Ollama's launcherIntegrationOrder, with the integrations it
# marks Hidden at the end. Ollama's `vscode` is deliberately absent: it reaches
# models only through Copilot Chat's built-in `ollama` vendor, which speaks the
# Ollama native API (/api/tags, /api/chat) and cannot be pointed at an
# OpenAI-compatible endpoint. Everything here talks to the Hub and nothing else.

INTEGRATIONS: list[Integration] = [
    Claude(), ChatGPT(), Hermes(), OpenClaw(), OpenCode(), HermesDesktop(), Codex(),
    Copilot(), OMP(), Cline(), Droid(), DeepSeekHarness(), Pi(), Pool(), Qwen(),
    ClaudeDesktop(), Kimi(), Muse(),
]

BY_NAME: dict[str, Integration] = {}
for _integration in INTEGRATIONS:
    BY_NAME[_integration.name] = _integration
    for _alias in _integration.aliases:
        BY_NAME[_alias] = _integration


# ------------------------------------------------------------------- commands


def cmd_integrations(_args) -> None:
    rows = []
    for item in INTEGRATIONS:
        persistent = item.writes_config
        rows.append({
            "name": item.name,
            "kind": item.kind,
            "available": item.availability(),
            "mode": "persistent" if persistent else "launch only",
            "launch": f"sah {item.name}" if item.launchable else "n/a",
            "install": f"sah {item.name} --install" if persistent else "n/a",
            "status": f"sah {item.name} --status",
            "restore": f"sah {item.name} --restore" if persistent else "n/a",
        })
    print_table(rows, [
        ("name", "Integration"), ("kind", "Kind"), ("available", "Installed"),
        ("mode", "Mode"), ("launch", "Launch"), ("install", "Install"),
        ("status", "Status"), ("restore", "Restore"),
    ])


def cmd_info(_args) -> None:
    active = hub_url()
    info = current_model_info()
    kv("Hub", active)
    if others := [c for c in _hub_candidates() if c != active]:
        kv("Fallback hubs", ", ".join(others))
    kv("OpenAI base", api_base())
    kv("Anthropic base", active)
    kv("API key", f"{API_KEY}  (any value works)")
    kv("Current model", info["id"] if info else "(none — launch one in the Hub)")


def cmd_env(args) -> None:
    if args.anthropic:
        print(f"export ANTHROPIC_BASE_URL={hub_url()}")
        print(f"export ANTHROPIC_AUTH_TOKEN={API_KEY}")
    else:
        print(f"export OPENAI_BASE_URL={api_base()}")
        print(f"export OPENAI_API_KEY={API_KEY}")


def cmd_set_hub(args) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    write_text(CONFIG_FILE, args.url.rstrip("/") + "\n")
    print(f"Hub set to {args.url}")


# ------------------------------------------------------------------ entrypoint


def _add_integration_parser(sub, integration: Integration):
    verb = "Launch" if integration.launchable else "Manage"
    parser = sub.add_parser(
        integration.name,
        aliases=list(integration.aliases),
        help=f"{verb} {integration.display} through {PROVIDER_NAME}",
        description=f"{verb} {integration.display} through {PROVIDER_NAME}.",
    )
    group = parser.add_mutually_exclusive_group()
    persistent = integration.writes_config
    group.add_argument("--install", action="store_true",
                       help=(f"Make the plain {integration.display} use {PROVIDER_NAME}"
                             if persistent else
                             f"Not available: {integration.display} is launch only"))
    group.add_argument("--restore", action="store_true",
                       help=(f"Restore previous plain {integration.display} settings"
                             if persistent else
                             f"Not available: {integration.display} is launch only"))
    group.add_argument("--status", action="store_true",
                       help=f"Show {PROVIDER_NAME} wiring status for {integration.display}")
    integration.add_arguments(parser)
    if integration.launchable:
        parser.add_argument("passthrough", nargs=argparse.REMAINDER, metavar="args",
                            help=f"Arguments passed to {integration.display}")
    parser.set_defaults(func=integration.run)
    return parser


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="sah",
        description=f"{PROVIDER_NAME} client launcher",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Lifecycle:\n"
            "  sah <client>              Configure the client for the Hub and launch it\n"
            "  sah <client> --install    Configure only, so the plain client uses the Hub\n"
            "  sah <client> --status     Show wiring status for the client\n"
            "  sah <client> --restore    Put the client's original settings back\n"
            "\n"
            "Client args:\n"
            "  sah <client> -- <args>    Pass args to the underlying client\n"
            "\n"
            "Discover integrations:\n"
            "  sah integrations          List every integration's mode and commands\n"
        ),
    )
    sub = parser.add_subparsers(dest="cmd", required=True, title="commands", metavar="<command>")

    sp = sub.add_parser("info", help="Show Hub URL and current model")
    sp.set_defaults(func=cmd_info)

    sp = sub.add_parser("env", help="Print Hub environment variables")
    sp.add_argument("--anthropic", action="store_true", help="Anthropic-shaped env vars")
    sp.set_defaults(func=cmd_env)

    sp = sub.add_parser("integrations", aliases=["clients"],
                        help="List integration modes and lifecycle commands")
    sp.set_defaults(func=cmd_integrations)

    sp = sub.add_parser("set-hub", help=f"Set the {PROVIDER_NAME} URL")
    sp.add_argument("url")
    sp.set_defaults(func=cmd_set_hub)

    for integration in INTEGRATIONS:
        _add_integration_parser(sub, integration)

    args, extras = parser.parse_known_args()
    if hasattr(args, "passthrough"):
        args.passthrough = [*extras, *args.passthrough]
    elif extras:
        parser.error(f"unrecognized arguments: {' '.join(extras)}")
    args.func(args)


if __name__ == "__main__":
    main()
