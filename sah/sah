        reject_managed_flags(extra, ("--config", "--config-file", "--model", "-m"), "sah kimi")
        return ["--config", self.inline_config(model), *extra]


# ----------------------------------------------------------------------- muse


class Muse(Integration):
    """Ollama's cmd/launch/muse.go. Muse has no additive model list and no flag
    for a catalog, and refuses to start without one; endpoint_transport is a
    single global provider switch, so writing the user's settings.json would
    repoint their whole Muse install. Both Ollama and sah therefore keep a
    private config root and pass it as XDG_CONFIG_HOME."""
    name, display, binary = "muse", "Muse Code", "muse"
    aliases = ("muse-code",)
    install_hint = "https://dev.meta.ai/install.sh"

    PROVIDER_ID = "meta"
    PROFILE_ID = "tbh"

    def supported(self) -> str | None:
        if sys.platform == "win32":
            return "Muse is not currently supported on Windows."
        return None

    def find_binary(self) -> str | None:
        if path := shutil.which("muse"):
            return path
        fallback = Path.home() / ".local/bin/muse"
        return str(fallback) if fallback.is_file() else None

    def config_home(self) -> Path:
        return CONFIG_DIR / "muse-config"

    def settings_path(self) -> Path:
        return self.config_home() / "muse" / "settings.json"

    def user_settings_path(self) -> Path:
        base = os.environ.get("XDG_CONFIG_HOME")
        return (Path(base) if base else Path.home() / ".config") / "muse" / "settings.json"

    def settings(self, model: Model) -> dict:
        # Muse persists its own settings back into whichever root it was given,
        # so once sah's file exists it is the base and anything Muse recorded
        # survives. Before that, seed from the user's own file so a first launch
        # keeps their skills, hooks, MCP servers and TUI preferences.
        settings = read_json(self.settings_path()) or read_json(self.user_settings_path())
        settings.setdefault("schema_version", 1)
        settings["provider"] = self.PROVIDER_ID
        settings["model"] = model.name
        settings["endpoint_transport"] = {
            # See resolved_api_base(): Muse's HTTP client does not do mDNS.
            "base_url": resolved_api_base(),
            # The Hub ignores credentials, and Muse refuses to start on its
            # default "bearer" unless one is configured.
            "auth": "none",
        }
        ctx = model.context(32768)
        settings["model_catalog"] = [{
            "model_id": model.name,
            "provider_id": self.PROVIDER_ID,
            "profile_id": self.PROFILE_ID,
            "display_label": model.name,
            "visibility": "visible",
            "display_order": 0,
            "is_default": True,
            "context_limit": ctx,
            "output_limit": min(ctx, 32768),
            "description": f"Served by {PROVIDER_NAME}",
        }]
        return settings

    def env(self, model: Model) -> dict:
        write_json(self.settings_path(), self.settings(model))
        return {"XDG_CONFIG_HOME": str(self.config_home())}

    def argv(self, model: Model, extra: list[str]) -> list[str]:
        args = list(extra)
        # DIVERGENCE (defect workaround, not preference): Muse defaults
        # --reasoning-effort to "high", which the Hub's SGLang backend rejects
        # with 400 ("Supported types are xhigh, medium, low") — and Muse
        # silently retry-loops on that error instead of reporting it, so the
        # launch just hangs. "medium" is accepted by every backend the Hub
        # serves. The user's own flag always wins.
        if not has_flag(args, "--reasoning-effort"):
            args += ["--reasoning-effort", "medium"]
        return args

    def extras(self) -> tuple[tuple[str, str], ...]:
        return (("Muse config root", str(self.config_home())),)


